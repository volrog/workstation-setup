# Environment
export PATH="$HOME/scripts:$HOME/.local/bin:$PATH"
export EDITOR=vim

# NVM and Node.js
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

if command -v corepack >/dev/null 2>&1; then
  corepack enable >/dev/null 2>&1
fi

# Bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# OpenCode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# Atlassian Forge
if command -v forge >/dev/null 2>&1; then
  . <(forge --completion)
fi

forge-use() {
  local profile="$1"
  local profile_file="$HOME/.forge-$profile"

  if [ -z "$profile" ]; then
    echo "Usage: forge-use <profile>"
    return 1
  fi

  if [ ! -f "$profile_file" ]; then
    echo "Missing $profile_file"
    return 1
  fi

  source "$profile_file"

  if command -v forge >/dev/null 2>&1; then
    forge whoami
  fi
}

if [ -z "$FORGE_EMAIL" ] && [ -z "$FORGE_API_TOKEN" ] && [ -f "$HOME/.forge-personal" ]; then
  source "$HOME/.forge-personal"
fi

# Prompt
parse_git_branch() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || return
  printf ' %s' "$branch"
}

autoload -U colors && colors
setopt PROMPT_SUBST

PROMPT='%n %1~ %F{green}$(parse_git_branch)%f $ '

# Aliases
# remove all node_modules recursive (inside nested folders too)
alias rmnm="find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' +"

alias gitst='git status'
alias gitch='git checkout'
alias gitme='git merge --no-ff'
alias gitre='git rebase'
alias gitsu='git submodule update --init --recursive'
alias gitrec='git rebase --continue'

alias lg='lazygit'
alias dc='docker compose'
alias ta='tmux attach'
alias tn='tmux new -s'

# Startup Directory
if [ -d "$HOME/projects" ]; then
  cd "$HOME/projects"
fi
